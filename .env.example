# WasteWiseAI Environment Configuration Example

ENV=development
DEBUG=true
PORT=8000

# Database: SQLite by default, PostgreSQL supported
DATABASE_URL=sqlite:///./wastewise.db
# For PostgreSQL on Render:
# DATABASE_URL=postgresql://user:password@hostname:5432/wastewise_db

# ML Inference & Performance
MAX_FPS_INFERENCE=2.5

# Privacy & Compliance
STORE_IMAGES_DEFAULT=false
IMAGE_RETENTION_HOURS=24

